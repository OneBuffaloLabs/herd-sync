{
  "name": "herd-sync-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@onebuffalolabs/eslint-config": "workspace:*",
    "@onebuffalolabs/tsconfig": "workspace:*",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.25.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.0"
}
