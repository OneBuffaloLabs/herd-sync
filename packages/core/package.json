{
  "name": "@onebuffalolabs/herd-sync",
  "version": "0.1.1",
  "description": "Modular local-first sync toolkit for static Next.js applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "pouchdb-browser": "^9.0.0"
  },
  "devDependencies": {
    "@onebuffalolabs/eslint-config": "workspace:*",
    "@onebuffalolabs/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pouchdb": "^6.4.2",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/pouchdb-core": "^7.0.15",
    "@types/pouchdb-find": "^7.3.3",
    "@types/pouchdb-replication": "^6.4.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.21.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.25.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
