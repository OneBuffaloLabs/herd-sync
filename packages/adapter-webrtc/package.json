{
  "name": "@onebuffalo/adapter-webrtc",
  "version": "0.1.0",
  "description": "Zero-backend P2P WebRTC sync adapter for HerdSync",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@onebuffalo/herd-sync": "workspace:*",
    "pouchdb-browser": "^9.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@onebuffalo/eslint-config": "workspace:*",
    "@onebuffalo/herd-sync": "workspace:*",
    "@onebuffalo/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/pouchdb-core": "^7.0.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.21.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
